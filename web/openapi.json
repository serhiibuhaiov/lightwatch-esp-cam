  "/api/scenarios": {
   "get": {
    "tags": [
     "Сценарії"
    ],
    "summary": "Сценарії та стан запусків",
    "description": "Визначення з `/scenarios.json` і останній запуск кожного (`state`, `run_steps`, `wait_reason`, для тригерів споживання `when` і `watch`). `limits`: ліміти редактора (як `limits.scenarios` у `/api/status`; `power_rule.max_for_s` залежить від інтервалу опитування). Запуск у паузі між кроками має `pause_left_s`.",
    "responses": {
     "401": {
      "description": "Потрібна авторизація (HTTP Basic)."
     },
     "403": {
      "description": "web_password порожній: API закрите.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "200": {
      "description": "Сценарії."
     }
    },
    "x-prefill": "self"
   },
   "put": {
    "tags": [
     "Сценарії"
    ],
    "summary": "Замінити список сценаріїв",
    "description": "**Повна заміна.** Сценарії, яких немає в запиті, видаляються (виконувані зупиняються). Тіло до 49152 байт, до 16 сценаріїв по 24 кроки.",
    "responses": {
     "401": {
      "description": "Потрібна авторизація (HTTP Basic)."
     },
     "403": {
      "description": "web_password порожній: API закрите.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "200": {
      "description": "Збережено.",
      "content": {
       "application/json": {
        "example": {
         "ok": true,
         "count": 2
        }
       }
      }
     },
     "400": {
      "description": "Недопустиме значення.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "413": {
      "description": "Тіло більше 49152 байт.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "415": {
      "description": "Не JSON.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "503": {
      "description": "Немає SD-картки.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "description": "Повний список.",
     "content": {
      "application/json": {
       "example": {
        "scenarios": [
         {
          "name": "power-restored",
          "enabled": true,
          "trigger": "power_on",
          "default_pause_s": 30,
          "steps": [
           {
            "device": "towel",
            "action": "on",
            "enabled": true,
            "pause_after_s": 300
           }
          ]
         },
         {
          "name": "heater-idle-off",
          "enabled": true,
          "trigger": "power_below",
          "when": {
           "device": "heater3",
           "watts": 100,
           "for_s": 120,
           "warmup_s": 60
          },
          "steps": [
           {
            "device": "heater3",
            "action": "off"
           }
          ]
         }
        ]
       }
      }
     }
    },
    "x-danger": "Повна заміна: сценарій, якого немає в тілі, буде видалено, а виконуваний зупинено.",
    "x-prefill": "/api/scenarios"
   }
  },
